# Instagram Credentials
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Shopee Affiliate Feed
SHOPEE_FEED_URL=https://affiliate.shopee.co.th/api/v1/datafeed/download?id=YOUR_FEED_ID
SHOPEE_FEED_CACHE_HOURS=6

# Claude API
ANTHROPIC_API_KEY=your_anthropic_key

# Posting schedule (24h format, comma-separated)
POST_TIMES=08:00,11:00,14:00,18:00,21:00
TIMEZONE=Asia/Bangkok

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pexels Stock Video
PEXELS_API_KEY=your_pexels_key

# Replicate (Stable Diffusion)
REPLICATE_API_TOKEN=your_replicate_token

# Feature flags (set to false to disable API calls)
TTS_ENABLED=true
STOCK_MEDIA_ENABLED=true
